# Raw upstream downloads, probes, and agent execution records are local only.
# Authored decisions, tickets, research reports, and review ballots remain visible.
/.scratch/research/
/.scratch/evaluation/
/.scratch/**/prompts/
*.jsonl

# Per-ticket git worktrees (see docs/agents/implementation-workflow.md).
/.worktrees/
